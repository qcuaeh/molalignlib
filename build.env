# Flags must separated by spaces
# Lines starting with # are ignored
# Blank lines are not allowed
#
# gfortran
#
FC= gfortran
base_flags= -std=f2008
build_flags= -O3
build_debug_flags= -O0 -g -fbacktrace -fcheck=all -ffpe-trap=invalid,zero,overflow -Wunused
#
# ifort
#
#FC= ifort
#base_flags= -stand f08
#build_flags= -O3
#env_build_debug_flags= -O0 -g -traceback -fpe0 -check bounds -warn all
